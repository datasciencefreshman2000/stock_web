# Supabase
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key

# Finnhub
FINNHUB_KEY=your_finnhub_api_key

# Fugle 台股報價
FUGLE_API_KEY=your_fugle_api_key

# 報價與匯率快取；cron 比這些值更密集時仍會沿用快取
PRICE_REFRESH_TTL_SECONDS=600
RATE_REFRESH_TTL_SECONDS=3600

# Protected scheduled refresh/snapshot endpoint
CRON_SECRET=replace_with_a_long_random_secret

# --- 網站登入（A1）---
# 用 `python backend/scripts/hash_password.py` 產生這兩個值。
# 兩個都沒填時，所有 /api 端點會回 503（fail closed），不會裸奔。
APP_PASSWORD_HASH=pbkdf2_sha256$260000$...$...
JWT_SECRET=至少_32_字元的隨機字串
JWT_EXPIRE_DAYS=30
# 只在本機開發時打開，會完全關閉 API 驗證
# AUTH_DISABLED=true

# CORS：留空 = 只允許同源（前後端同一個 Vercel 專案時就留空）
# CORS_ORIGINS=https://your-app.vercel.app

# --- FIFO checkpoint（A4）---
FIFO_SETTLE_INTERVAL_HOURS=12
FIFO_CHECKPOINT_LAG_DAYS=1

# Frontend
VITE_API_BASE=/api
